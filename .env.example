# 连接配置（服务端启动时从环境变量读取）
# 复制为你的环境变量 / 部署密钥，不要提交真实 key 到仓库

# ---- 服务 ----
# PORT=8787                    # HTTP 端口
# DATA_DIR=data                # 数据目录（账本 ledger/ + 树快照 forest.json）

# ---- DeepSeek LLM（节点配置 agentKernel:'deepseek' 时启用）----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- 钉钉通知（可选，自定义机器人 webhook）----
DINGTALK_WEBHOOK=
